{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grid-column.schema.json",
  "title": "GridColumn (1 item trong gridflexs / configs)",
  "type": "object",
  "required": ["columnField", "columnCaption", "ordinal"],
  "properties": {
    "columnField": { "type": "string", "description": "alias map vào row.dataList (camelCase)" },
    "columnCaption": { "type": "string" },
    "columnCaptionE": { "type": "string" },
    "columnWidth": { "type": "integer", "minimum": 0 },
    "fieldType": {
      "type": "string",
      "enum": ["text", "number", "date", "datetime", "html", "image", "link", "boolean", "checkbox", "files", "FileAttach"]
    },
    "isStatusLable": { "type": "boolean" },
    "pinned": { "type": ["string", "null"], "enum": ["left", "right", "", null] },
    "isHide": { "type": "boolean" },
    "isFilter": { "type": "boolean" },
    "isMasterDetail": { "type": "boolean" },
    "ordinal": { "type": "integer" },
    "columnClass": { "type": ["string", "null"] },
    "cellClass": { "type": ["string", "null"] },
    "conditionClass": { "type": ["string", "null"] },
    "group_cd": { "type": ["string", "null"] },
    "group_name": { "type": ["string", "null"] },
    "columnObject": { "type": ["string", "null"] },
    "children": { "type": ["array", "null"], "items": { "$ref": "grid-column.schema.json" } }
  },
  "additionalProperties": true
}
