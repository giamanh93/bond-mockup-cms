# ============================================================
# BuildStock — Environment Variables
# Copy file này thành .env và thay đổi các giá trị bên dưới
# ============================================================

# App
NODE_ENV=development
APP_PORT=4000

# Database (PostgreSQL)
DB_NAME=buildstock_db
DB_USER=buildstock_user
DB_PASS=buildstock_pass_2026
DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@db:5432/${DB_NAME}

# Cache (Redis)
REDIS_PASS=redis_secret_pass
REDIS_URL=redis://:${REDIS_PASS}@cache:6379

# JWT Auth — đổi thành chuỗi ngẫu nhiên dài khi production
JWT_SECRET=buildstock-change-this-secret-in-production

# File Storage (MinIO)
MINIO_USER=buildstock_admin
MINIO_PASS=minio_secret_pass_2026
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://localhost/storage

# Frontend (Vite)
VITE_API_URL=http://localhost/api
VITE_APP_NAME=BuildStock
VITE_APP_URL=http://localhost
